# Copy to .env and edit. Secrets do NOT go here - see scripts/generate-secrets.sh (./secrets/).

# Public URL encoded in QR codes (campus pages are PUBLIC_BASE_URL/<campus-slug>)
PUBLIC_BASE_URL=https://captions.example.com
# Exact origin of the admin dashboard (used for CSRF Origin checks)
ADMIN_ORIGIN=https://admin.example.com

# Optional containers, comma-separated:
#   newt         Pangolin tunnel (VPS behind Pangolin)
#   local-audio  audio input from an interface on this server (Linux; see compose.local.yml)
COMPOSE_PROFILES=newt
# Adds a simulated "Test tone" input to local audio (for trying it without hardware).
LOCAL_AUDIO_TEST_TONE=0

# Pangolin site (Newt) credentials from your Pangolin dashboard -> Sites -> Add site -> Newt
PANGOLIN_ENDPOINT=https://pangolin.example.com
NEWT_ID=
NEWT_SECRET=
NEWT_VERSION=latest

# Proxy hops that append X-Forwarded-For for admin + audio: 1 = Pangolin only.
# Keep admin/audio DNS records DNS-only (grey cloud) so IP allowlists see real church IPs.
TRUSTED_PROXY_HOPS=1
# Public caption site only: 2 if captions.<domain> is proxied (orange cloud) through Cloudflare.
PUBLIC_TRUSTED_PROXY_HOPS=1

# Keep true in production. Set COOKIE_SECURE=false only for plain-http local testing.
COOKIE_SECURE=true
ADMIN_REQUIRE_MFA=true

LOG_LEVEL=INFO
IMAGE_TAG=local

# Public stream limits (many phones share one church Wi-Fi IP, so per-IP is generous)
PUBLIC_MAX_STREAMS=3000
PUBLIC_MAX_STREAMS_PER_IP=400
