# Copy to .env and edit. Secrets do NOT go here - see scripts/generate-secrets.sh (./secrets/).

# ---- Addresses people use -------------------------------------------------------------
# The caption site address encoded in the QR codes (campus pages are .../campus/<campus>).
PUBLIC_BASE_URL=http://localhost:8080
# Exact address of the admin dashboard as typed in the browser (used for CSRF checks).
# Several are allowed, comma-separated, e.g. http://192.168.1.20:8081,http://onevoice.local:8081
ADMIN_ORIGIN=http://localhost:8081

# ---- Ports ----------------------------------------------------------------------------
# 8080 caption site (public) · 8081 admin dashboard (staff) · 8082 audio input (Sender app)
PUBLIC_PORT=8080
ADMIN_PORT=8081
INGEST_PORT=8082
# Local setup:          0.0.0.0   -> reachable from other devices on your network
# Reverse proxy setup:  127.0.0.1 -> only this machine; the proxy forwards to 127.0.0.1:<port>
PUBLIC_BIND=0.0.0.0
ADMIN_BIND=0.0.0.0
INGEST_BIND=0.0.0.0

# ---- Reverse proxy / HTTPS -------------------------------------------------------------
# Number of proxies in front of OneVoice that add X-Forwarded-For (0 = none, 1 = one proxy).
TRUSTED_PROXY_HOPS=0
# true when people reach the dashboard over https:// (reverse proxy with TLS).
COOKIE_SECURE=false
ADMIN_REQUIRE_MFA=true

# ---- Optional ---------------------------------------------------------------------------
# local-audio = capture from an audio interface on this machine (Linux; see compose.audio.yml)
#COMPOSE_PROFILES=local-audio
# Adds a simulated "Test tone" input to local audio (for trying it without hardware).
LOCAL_AUDIO_TEST_TONE=0

LOG_LEVEL=INFO
IMAGE_TAG=local
PUBLIC_MAX_STREAMS=3000
PUBLIC_MAX_STREAMS_PER_IP=400
