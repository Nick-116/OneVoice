[Unit]
Description=OneVoice Sender (USB audio to live captions, web setup on port 80)
After=network-online.target sound.target
Wants=network-online.target

[Service]
Type=simple
User=onevoice
Group=onevoice
# audio: USB input. shadow: read-only /etc/shadow to check the Pi account password for the web sign-in.
SupplementaryGroups=audio shadow
WorkingDirectory=/opt/onevoice-sender
ExecStart=/opt/onevoice-sender/venv/bin/python -m church_sender --web --port 80
Environment=ONEVOICE_CONFIG_DIR=/var/lib/onevoice
Environment=ONEVOICE_LOG_DIR=/var/log/onevoice
Environment=ONEVOICE_SECRETS_FILE=/var/lib/onevoice/secrets.json
Environment=ONEVOICE_LOGIN_GROUP=sudo
StateDirectory=onevoice
StateDirectoryMode=0700
LogsDirectory=onevoice
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
