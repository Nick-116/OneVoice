# pi-gen settings for the OneVoice Sender image (see build.sh and .github/workflows/release.yml).
IMG_NAME=OneVoiceSender
RELEASE=bookworm
TARGET_HOSTNAME=onevoice-sender
LOCALE_DEFAULT=en_US.UTF-8
KEYBOARD_KEYMAP=us
KEYBOARD_LAYOUT="English (US)"
TIMEZONE_DEFAULT=America/New_York
# No default password: the account stays locked until you set a username and
# password in Raspberry Pi Imager ("Edit settings") when flashing.
FIRST_USER_NAME=pi
DISABLE_FIRST_BOOT_USER_RENAME=0
ENABLE_SSH=0
DEPLOY_COMPRESSION=xz
STAGE_LIST="stage0 stage1 stage2 stage-onevoice"
